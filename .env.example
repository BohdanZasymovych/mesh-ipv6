# Per-machine settings. Copy to .env and fill in the two required values:
#   cp .env.example .env
# .env is gitignored. It is read by docker compose and by scripts/*.sh.

# Required: serial port of the RCP board. Find it with: ls -l /dev/serial/by-id/
# Example: /dev/serial/by-id/usb-Zephyr_Project_Thread_Co-Processor_0123456789ABCDEF-if00
RCP_DEVICE=

# Required: interface that connects this laptop to the LAN (Wi-Fi or Ethernet).
# Find it with: ip -br link   (e.g. wlo1, wlp2s0, enp3s0)
INFRA_IF=

# Optional, defaults shown
#THREAD_CHANNEL=25
#DATASET_FILE=./thread.dataset
#OTBR_DATA_DIR=./otbr-data
#OT_LOG_LEVEL=5
#NCS_DIR=$HOME/ncs/v3.4.2
